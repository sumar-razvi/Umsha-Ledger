// ---- core/ids.js ----
var Ids = (function () {
// core/ids.js: human-readable, prefixed IDs. Formats are defined in docs/04-data-model.md.
// Pure: the server allocates numbers from the Sequences tab under the script lock
// and calls these functions to turn them into IDs.


const DOC_NUMBER_WIDTH = 5;
const LINE_NUMBER_WIDTH = 2;

// Year-scoped document and ledger prefixes: PREFIX-YYYY-NNNNN.
const DOC_PREFIXES = ['JE', 'INV', 'BILL', 'JOB', 'PAY', 'SALE', 'SM', 'CNT', 'CUP', 'REC', 'ATT', 'AUD'];

// Master data prefixes (not year-scoped) and their zero-pad widths.
const MASTER_WIDTHS = { CUS: 5, VEN: 5, FAM: 3, FAB: 4, TRM: 4, PKG: 4, SKU: 6, USR: 3 };

const ITEM_PREFIX_BY_CATEGORY = { FABRIC: 'FAB', TRIM: 'TRM', PACKAGING: 'PKG', SKU: 'SKU' };

function checkSequenceNumber(n) {
  if (!Number.isSafeInteger(n) || n < 1) {
    throw Money.validationError('Sequence number must be a positive integer, got ' + n);
  }
}

function checkYear(year) {
  if (!Number.isInteger(year) || year < 2000 || year > 9999) {
    throw Money.validationError('Year must be a 4-digit year, got ' + year);
  }
}

function checkPrefix(prefix, allowed) {
  if (allowed.indexOf(prefix) === -1) {
    throw Money.validationError('Unknown ID prefix: ' + prefix);
  }
}

// "2026-10-06" -> 2026. Documents are numbered by the calendar year of their
// own date (not the fiscal year, not the posting time).
// TODO(decision-D-18): switch to fiscal-year numbering if the accountant prefers it.
function yearOfDate(isoDate) {
  const m = /^(\d{4})-(\d{2})-(\d{2})$/.exec(String(isoDate));
  if (!m) throw Money.validationError('Date must be YYYY-MM-DD, got ' + isoDate, 'date');
  const year = Number(m[1]);
  const month = Number(m[2]);
  const day = Number(m[3]);
  const d = new Date(Date.UTC(year, month - 1, day));
  if (d.getUTCFullYear() !== year || d.getUTCMonth() !== month - 1 || d.getUTCDate() !== day) {
    throw Money.validationError('Not a real calendar date: ' + isoDate, 'date');
  }
  return year;
}

// formatDocId('INV', 2026, 42) => 'INV-2026-00042'
function formatDocId(prefix, year, n) {
  checkPrefix(prefix, DOC_PREFIXES);
  checkYear(year);
  checkSequenceNumber(n);
  return prefix + '-' + year + '-' + String(n).padStart(DOC_NUMBER_WIDTH, '0');
}

// formatMasterId('CUS', 1) => 'CUS-00001'
function formatMasterId(prefix, n) {
  checkPrefix(prefix, Object.keys(MASTER_WIDTHS));
  checkSequenceNumber(n);
  return prefix + '-' + String(n).padStart(MASTER_WIDTHS[prefix], '0');
}

// formatLineId('JE-2026-00981', 1) => 'JE-2026-00981-01'
function formatLineId(parentId, lineNo) {
  if (!parentId) throw Money.validationError('Line ID needs a parent ID');
  checkSequenceNumber(lineNo);
  return parentId + '-' + String(lineNo).padStart(LINE_NUMBER_WIDTH, '0');
}

// 'INV-2026-00042' => {prefix:'INV', year:2026, n:42}; null if not a document ID.
function parseDocId(id) {
  const m = /^([A-Z]+)-(\d{4})-(\d+)$/.exec(String(id));
  if (!m || DOC_PREFIXES.indexOf(m[1]) === -1 || m[3].length < DOC_NUMBER_WIDTH) return null;
  return { prefix: m[1], year: Number(m[2]), n: Number(m[3]) };
}

// Key of the Sequences row a document number comes from: 'INV-2026'.
function docSequenceKey(prefix, year) {
  checkPrefix(prefix, DOC_PREFIXES);
  checkYear(year);
  return prefix + '-' + year;
}

// Key of the Sequences row a master-data number comes from: 'CUS'.
function masterSequenceKey(prefix) {
  checkPrefix(prefix, Object.keys(MASTER_WIDTHS));
  return prefix;
}

// Take `count` numbers from a Sequences row whose `next` is the next unused
// number (a missing row starts at 1). Returns the numbers and the new `next`
// to write back. Must be called under the script lock.
function reserveNumbers(currentNext, count) {
  const start = currentNext === undefined || currentNext === null || currentNext === '' ? 1 : Number(currentNext);
  checkSequenceNumber(start);
  if (!Number.isInteger(count) || count < 1) {
    throw Money.validationError('Must reserve at least one number, got ' + count);
  }
  const numbers = [];
  for (let i = 0; i < count; i++) numbers.push(start + i);
  return { numbers: numbers, next: start + count };
}

return {
  DOC_PREFIXES,
  MASTER_WIDTHS,
  ITEM_PREFIX_BY_CATEGORY,
  yearOfDate,
  formatDocId,
  formatMasterId,
  formatLineId,
  parseDocId,
  docSequenceKey,
  masterSequenceKey,
  reserveNumbers,
};
})();

// ---- core/inventory.js ----
var Inventory = (function () {
// core/inventory.js: stock quantities and weighted-average cost.
// Pure: no SpreadsheetApp, no DOM. Runs in Node and Apps Script.
//
// Units (docs/03-accounting-rules.md, Rounding; decision D-19):
//   qty            decimal with up to 3 places at the edges (12.5 m), held
//                  internally as integer thousandths (qtyMilli) so sums never drift
//   valuePaisa     exact stock value, the figure that must equal the GL
//   avgCostMicro   paisa x 10,000 per unit (Rs 2,176.470588 -> 2,176,470,588)
//
// Rules, shared by live posting and by rebuildItemBalances so they always agree:
//   - A move adds its qty and value to the item.
//   - Inbound moves (qty > 0) recompute the average from value / qty.
//     So does a REVERSAL that takes stock out at its original cost.
//   - Outbound moves at the average leave it unchanged.
//   - An outbound move that takes qty to exactly zero carries the item's whole
//     remaining value, so no paisa are stranded in stock.


const QTY_PLACES = 3;
const QTY_SCALE = 1000;
const MICRO = 10000; // avgCostMicro = paisa x MICRO per unit
const MICRO_PER_MILLI = 10000000n; // MICRO x QTY_SCALE

const ACCOUNT_KEY_BY_CATEGORY = { FABRIC: 'INV_FABRIC', TRIM: 'INV_TRIMS', PACKAGING: 'INV_PACKAGING', SKU: 'INV_FG' };
const COMPONENT_BY_CATEGORY = { FABRIC: 'FABRIC', TRIM: 'TRIMS', PACKAGING: 'PACKAGING' };
const INBOUND_TYPES = ['PURCHASE', 'RETURN_TO_STOCK', 'BATCH_OUTPUT', 'SALE_RETURN', 'OPENING'];

// 12.5 -> 12500. Throws E_VALIDATION for more than 3 decimal places.
function toMilli(qty) {
  return Money.scaleDecimal(qty, QTY_PLACES, 'qty');
}

// 12500 -> 12.5
function fromMilli(qtyMilli) {
  return qtyMilli / QTY_SCALE;
}

// Average cost of valuePaisa spread over qtyMilli.
function avgFrom(valuePaisa, qtyMilli) {
  return Money.divRoundHalfEven(BigInt(valuePaisa) * MICRO_PER_MILLI, qtyMilli);
}

// Value of qtyMilli at avgCostMicro, rounded to the paisa.
function valueAt(qtyMilli, avgCostMicro) {
  return Money.divRoundHalfEven(BigInt(qtyMilli) * BigInt(avgCostMicro), MICRO_PER_MILLI);
}

// qty x unit price in paisa, rounded to the paisa: qtyTimesPaisa(2.5, 200000) = 500000.
function qtyTimesPaisa(qty, unitPaisa) {
  Money.assertPaisa(unitPaisa, 'unitPrice');
  return Money.divRoundHalfEven(BigInt(toMilli(qty)) * BigInt(unitPaisa), QTY_SCALE);
}

function itemBrand(item) {
  return item.category === 'SKU' ? 'MIRAE' : 'SHARED';
}

function emptyState() {
  return { qtyMilli: 0, valuePaisa: 0, avgCostMicro: 0 };
}

function stateFromBalance(b) {
  if (!b) return emptyState();
  return {
    qtyMilli: toMilli(b.qty || 0),
    valuePaisa: Number(b.valuePaisa || 0),
    avgCostMicro: Number(b.avgCostMicro || 0),
  };
}

function balanceFromState(itemId, s) {
  return { itemId: itemId, qty: fromMilli(s.qtyMilli), avgCostMicro: s.avgCostMicro, valuePaisa: s.valuePaisa };
}

// Apply one stock move to an item's state (mutates). The single source of
// truth for how moves change quantity, value and average.
function applyMove(state, move) {
  const qm = toMilli(move.qty);
  const v = move.valuePaisa;
  state.qtyMilli += qm;
  state.valuePaisa += v;
  const recompute = qm > 0 || (move.moveType === 'REVERSAL' && qm < 0);
  if (recompute) {
    if (state.qtyMilli > 0) state.avgCostMicro = avgFrom(state.valuePaisa, state.qtyMilli);
    else if (qm > 0) state.avgCostMicro = avgFrom(v, qm);
  }
  return state;
}

// Rebuild ItemBalances from StockMoves, in the order given (date, then id).
// Returns {itemId: {itemId, qty, avgCostMicro, valuePaisa}}.
function rebuildItemBalances(stockMoves) {
  const states = {};
  stockMoves.forEach(function (m) {
    if (!states[m.itemId]) states[m.itemId] = emptyState();
    applyMove(states[m.itemId], m);
  });
  const out = {};
  Object.keys(states).forEach(function (id) { out[id] = balanceFromState(id, states[id]); });
  return out;
