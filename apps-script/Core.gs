// A working copy of item balances for one entry. Each operation returns the
// stock move it made; updates() returns the new balances of touched items.
function createStockLedger(itemBalances, opts) {
  const balances = itemBalances || {};
  const allowNegative = Validate.isTrue((opts || {}).allowNegativeStock);
  const states = {};
  const moved = {};

  function state(itemId) {
    if (!states[itemId]) states[itemId] = stateFromBalance(balances[itemId]);
    return states[itemId];
  }

  function positiveMilli(qty) {
    const qm = toMilli(qty);
    if (qm <= 0) Validate.fail('E_VALIDATION', 'Quantity must be more than zero', 'qty');
    return qm;
  }

  function checkStock(itemId, s, qm) {
    if (qm > s.qtyMilli && !allowNegative) {
      Validate.fail('E_NEG_STOCK', 'Not enough stock of ' + itemId + ': have ' + fromMilli(s.qtyMilli) + ', need ' + fromMilli(qm), 'qty');
    }
  }

  function record(itemId, s, qm, valuePaisa, moveType) {
    const move = {
      itemId: itemId,
      qty: fromMilli(qm),
      valuePaisa: valuePaisa,
      unitCostMicro: qm === 0 ? 0 : avgFrom(Math.abs(valuePaisa), Math.abs(qm)),
      moveType: moveType,
    };
    applyMove(s, move);
    moved[itemId] = true;
    return move;
  }

  return {
    // Stock in at a known value (purchase, batch output, return at original cost).
    receive: function (itemId, qty, valuePaisa, moveType) {
      Money.assertPaisa(valuePaisa, 'value');
      if (valuePaisa < 0) Validate.fail('E_VALIDATION', 'Stock value cannot be negative', 'value');
      return record(itemId, state(itemId), positiveMilli(qty), valuePaisa, moveType);
    },
    // Stock out at weighted-average cost (issue, sale, shortfall).
    issue: function (itemId, qty, moveType) {
      const s = state(itemId);
      const qm = positiveMilli(qty);
      checkStock(itemId, s, qm);
      const value = qm === s.qtyMilli ? s.valuePaisa : valueAt(qm, s.avgCostMicro);
      return record(itemId, s, -qm, -value, moveType);
    },
    // Reverse an inbound move: stock out at its original cost (R22).
    // If that empties the item but leaves value behind, the leftover is
    // returned as `residualPaisa` and cleared, for the caller to post.
    removeAtCost: function (itemId, qty, valuePaisa) {
      const s = state(itemId);
      const qm = positiveMilli(qty);
      checkStock(itemId, s, qm);
      const move = record(itemId, s, -qm, -valuePaisa, 'REVERSAL');
      let residualPaisa = 0;
      if (s.qtyMilli === 0 && s.valuePaisa !== 0) {
        residualPaisa = s.valuePaisa;
        return { move: move, residualPaisa: residualPaisa, residualMove: record(itemId, s, 0, -residualPaisa, 'ADJUSTMENT') };
      }
      if (s.qtyMilli > 0 && s.valuePaisa < 0) {
        Validate.fail('E_VALIDATION', 'Cannot reverse: the stock of ' + itemId + ' has already been used. Post a stock adjustment instead.');
      }
      return { move: move, residualPaisa: 0, residualMove: null };
    },
    // Current working balance of an item.
    balance: function (itemId) {
      return balanceFromState(itemId, state(itemId));
    },
    // New balances of the items that moved (only those: reading a balance is not a change).
    updates: function () {
      return Object.keys(moved).sort().map(function (id) { return balanceFromState(id, states[id]); });
    },
  };
}

return {
  MICRO,
  ACCOUNT_KEY_BY_CATEGORY,
  COMPONENT_BY_CATEGORY,
  INBOUND_TYPES,
  toMilli,
  fromMilli,
  avgFrom,
  valueAt,
  qtyTimesPaisa,
  itemBrand,
  applyMove,
  rebuildItemBalances,
  movementLedger,
  createStockLedger,
};
})();

// ---- core/master.js ----
var Master = (function () {
// core/master.js: checks and normalisation for master data (contacts,
// items, jobs, users) before the server writes them.
// Pure: no SpreadsheetApp, no DOM. Runs in Node and Apps Script.


const fail = Validate.fail;
const isBlank = Validate.isBlank;

const CONTACT_KINDS = ['CUSTOMER', 'VENDOR', 'BOTH', 'FAMILY'];
const VENDOR_TYPES = ['SUPPLIER', 'KARIGAR', 'SERVICE', 'OTHER'];
const FILER_STATUSES = ['FILER', 'NON_FILER'];
const ITEM_CATEGORIES = ['FABRIC', 'TRIM', 'PACKAGING', 'SKU'];
const ITEM_UNITS = ['M', 'PC', 'G', 'SET'];
const DEFAULT_UNIT = { FABRIC: 'M', TRIM: 'PC', PACKAGING: 'PC', SKU: 'PC' };
const JOB_TYPES = ['MTO_ORDER', 'RTW_BATCH'];
const CONTACT_PREFIX = { CUSTOMER: 'CUS', BOTH: 'CUS', VENDOR: 'VEN', FAMILY: 'FAM' };

function text(v) {
  return isBlank(v) ? '' : String(v).trim();
}

function oneOf(value, allowed, field, label) {
  if (allowed.indexOf(value) === -1) fail('E_VALIDATION', label + ' must be one of ' + allowed.join(', '), field);
  return value;
}

// Pakistani mobile numbers to 92XXXXXXXXXX: "0300-1234567", "+92 300 1234567",
// "3001234567" and "923001234567" all become "923001234567". Blank stays blank.
function normalizePhone(input) {
  if (isBlank(input)) return '';
  let d = String(input).replace(/[^\d+]/g, '');
  if (d.indexOf('+') > 0) fail('E_VALIDATION', 'Phone number is not valid: ' + input, 'phone');
  d = d.replace('+', '');
  if (d.indexOf('0092') === 0) d = d.slice(2);
  if (/^03\d{9}$/.test(d)) d = '92' + d.slice(1);
  else if (/^3\d{9}$/.test(d)) d = '92' + d;
  if (!/^92\d{10}$/.test(d)) fail('E_VALIDATION', 'Phone number should look like 0300 1234567, got ' + input, 'phone');
  return d;
}

function findTax(taxCodes, id, kinds, field) {
  if (isBlank(id)) return '';
  const t = (taxCodes || []).filter(function (x) { return x.id === id; })[0];
  if (!t) fail('E_VALIDATION', 'Unknown tax code ' + id, field);
  if (kinds.indexOf(t.kind) === -1) fail('E_VALIDATION', 'Tax code ' + id + ' cannot be used here', field);
  return id;
}

function optionalPaisa(v, field) {
  if (isBlank(v)) return '';
  Money.assertPaisa(v, field);
  if (v < 0) fail('E_VALIDATION', field + ' cannot be negative', field);
  return v;
}

// Contact create/update. existing: the current row (update) or null (create).
// all: every contact, for the duplicate-phone warning.
// Returns {row, prefix (create only), warnings}.
function prepareContact(input, existing, all, lookups) {
  const l = lookups || {};
  const base = existing || {};
  const merged = Object.assign({}, base, input);
  const kind = oneOf(merged.kind, CONTACT_KINDS, 'kind', 'Kind');
  if (existing && existing.kind !== kind) {
    const pair = [existing.kind, kind].sort().join('/');
    if (['BOTH/CUSTOMER', 'BOTH/VENDOR'].indexOf(pair) === -1) fail('E_VALIDATION', 'A ' + existing.kind.toLowerCase() + ' cannot become a ' + kind.toLowerCase(), 'kind');
  }
  const name = text(merged.name);
  if (!name) fail('E_VALIDATION', 'Enter a name', 'name');
  const phone = normalizePhone(merged.phone);
  const email = text(merged.email).toLowerCase();
  if (email && !/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(email)) fail('E_VALIDATION', 'Email address is not valid', 'email');
  const isVendor = kind === 'VENDOR' || kind === 'BOTH';
  const row = {
    kind: kind, name: name, phone: phone, email: email, city: text(merged.city), address: text(merged.address),
    cnic: text(merged.cnic), ntn: text(merged.ntn), strn: text(merged.strn),
    filerStatus: isBlank(merged.filerStatus) ? '' : oneOf(merged.filerStatus, FILER_STATUSES, 'filerStatus', 'Filer status'),
    vendorType: isVendor ? oneOf(merged.vendorType || 'OTHER', VENDOR_TYPES, 'vendorType', 'Vendor type') : '',
    whtTaxCodeId: isVendor ? findTax(l.taxCodes, merged.whtTaxCodeId, ['WHT'], 'whtTaxCodeId') : '',
    defaultBrand: isBlank(merged.defaultBrand) ? '' : oneOf(merged.defaultBrand, Validate.BRANDS, 'defaultBrand', 'Brand'),
    openingBalancePaisa: optionalPaisa(merged.openingBalancePaisa, 'openingBalancePaisa') || 0,
    notes: text(merged.notes),
    isActive: isBlank(merged.isActive) ? true : Validate.isTrue(merged.isActive),
  };
  if (row.cnic && !/^\d{5}-?\d{7}-?\d$/.test(row.cnic)) fail('E_VALIDATION', 'CNIC should look like 42101-1234567-1', 'cnic');
  const warnings = [];
  if (phone) {
    const dup = (all || []).filter(function (c) { return c.phone === phone && c.id !== base.id; })[0];
    if (dup) warnings.push('Phone ' + phone + ' is already used by ' + dup.name + ' (' + dup.id + ')');
  }
  return { row: row, prefix: existing ? null : CONTACT_PREFIX[kind], warnings: warnings };
}

// Item create/update. Category cannot change once created (its stock account depends on it).
function prepareItem(input, existing, all, lookups) {
  const l = lookups || {};
  const base = existing || {};
  const merged = Object.assign({}, base, input);
  const category = oneOf(merged.category, ITEM_CATEGORIES, 'category', 'Category');
  if (existing && existing.category !== category) fail('E_VALIDATION', 'An item\'s category cannot change', 'category');
  const name = text(merged.name);
  if (!name) fail('E_VALIDATION', 'Enter a name', 'name');
  const row = {
    category: category, name: name, unit: oneOf(merged.unit || DEFAULT_UNIT[category], ITEM_UNITS, 'unit', 'Unit'),
    style: text(merged.style), size: text(merged.size), colour: text(merged.colour), collection: text(merged.collection),
    barcode: text(merged.barcode), salePricePaisa: optionalPaisa(merged.salePricePaisa, 'salePricePaisa'),
    taxCodeId: findTax(l.taxCodes, merged.taxCodeId, ['SALES_OUTPUT', 'EXEMPT', 'ZERO'], 'taxCodeId'),
    reorderLevel: isBlank(merged.reorderLevel) ? '' : Inventory.fromMilli(Inventory.toMilli(merged.reorderLevel)),
    isActive: isBlank(merged.isActive) ? true : Validate.isTrue(merged.isActive),
  };
  if (row.reorderLevel !== '' && row.reorderLevel < 0) fail('E_VALIDATION', 'Reorder level cannot be negative', 'reorderLevel');
  if (row.barcode) {
    const dup = (all || []).filter(function (i) { return i.barcode === row.barcode && i.id !== base.id; })[0];
    if (dup) fail('E_VALIDATION', 'Barcode ' + row.barcode + ' is already on ' + dup.name + ' (' + dup.id + ')', 'barcode');
  }
  let id = null;
  if (!existing && !isBlank(input.id)) {
    id = String(input.id).trim().toUpperCase();
    if (category !== 'SKU' || !/^SKU-[A-Z0-9]+(-[A-Z0-9]+)*$/.test(id)) fail('E_VALIDATION', 'Only SKUs can choose their own ID, like SKU-AYLA-M-RED', 'id');
    if ((all || []).some(function (i) { return i.id === id; })) fail('E_VALIDATION', 'Item ' + id + ' already exists', 'id');
  }
  return { row: row, id: id, prefix: existing || id ? null : { FABRIC: 'FAB', TRIM: 'TRM', PACKAGING: 'PKG', SKU: 'SKU' }[category], warnings: [] };
}

// New job (MTO order or RTW batch) with its lines. ctx: {contacts, items,
// taxCodes, accountsByCode, settings}. Returns {job, lines} without ids.
function prepareJob(input, ctx, today) {
  const type = oneOf(input.type, JOB_TYPES, 'type', 'Job type');
  const title = text(input.title);
  if (!title) fail('E_VALIDATION', 'Enter a title', 'title');
  const bookedDate = Validate.checkDate(input.bookedDate || today, 'bookedDate');
  const promisedDate = isBlank(input.promisedDate) ? '' : Validate.checkDate(input.promisedDate, 'promisedDate');
  if (promisedDate && promisedDate < bookedDate) fail('E_VALIDATION', 'Promised date is before the booking date', 'promisedDate');
  const job = {
    type: type, brand: type === 'MTO_ORDER' ? 'UMSHA' : 'MIRAE', contactId: '', title: title, description: text(input.description),
    quotedPricePaisa: 0, taxCodeId: '', bookedDate: bookedDate, promisedDate: promisedDate, deliveredDate: '', status: 'OPEN',
    revenueAccount: '', invoiceId: '', collection: text(input.collection), notes: text(input.notes),
    budgetCostPaisa: optionalPaisa(input.budgetCostPaisa, 'budgetCostPaisa'),
  };
  const prepared = prepareJobLines(type, input.lines || [], ctx, 0);
  const lines = prepared.lines;
  job.quotedPricePaisa = prepared.totalPaisa;
  if (type === 'MTO_ORDER') {
    const c = ctx.contacts && ctx.contacts[input.contactId];
    if (!c || (c.kind !== 'CUSTOMER' && c.kind !== 'BOTH')) fail('E_VALIDATION', 'Choose the customer for this order', 'contactId');
    if (!lines.length) fail('E_VALIDATION', 'Add at least one piece to the order', 'lines');
    job.contactId = c.id;
    job.taxCodeId = findTax(ctx.taxCodes, input.taxCodeId, ['SALES_OUTPUT', 'EXEMPT', 'ZERO'], 'taxCodeId');
    const rev = String(input.revenueAccount || (ctx.settings || {}).defaultMtoRevenueAccount || '');
    const acct = ctx.accountsByCode && ctx.accountsByCode[rev];
    if (!acct || acct.type !== 'REVENUE') fail('E_VALIDATION', 'Choose a revenue account for this order', 'revenueAccount');
    job.revenueAccount = rev;
  } else {
    job.quotedPricePaisa = '';
  }
  return { job: job, lines: lines };
}

// Validate job lines: MTO lines are priced pieces; RTW lines are planned SKU
// outputs with a cost-split weight. Returns {lines, totalPaisa}.
function prepareJobLines(type, input, ctx, sortFrom) {
  let total = 0;
  const lines = input.map(function (l, i) {
    const field = 'lines[' + i + ']';
    const qty = isBlank(l.qty) ? 1 : l.qty;
    if (Inventory.toMilli(qty) <= 0) fail('E_VALIDATION', 'Quantity must be more than zero', field + '.qty');
    if (type === 'MTO_ORDER') {
      const description = text(l.description);
      if (!description) fail('E_VALIDATION', 'Describe each piece', field + '.description');
      Money.assertPaisa(l.unitPricePaisa, field + '.unitPricePaisa');
      if (l.unitPricePaisa < 0) fail('E_VALIDATION', 'Price cannot be negative', field + '.unitPricePaisa');
      const discount = optionalPaisa(l.discountPaisa, field + '.discountPaisa') || 0;
      const gross = Inventory.qtyTimesPaisa(qty, l.unitPricePaisa);
      if (discount > gross) fail('E_VALIDATION', 'A discount is bigger than its line', field + '.discountPaisa');
      total += gross - discount;
      return { description: description, itemId: '', qty: qty, unitPricePaisa: l.unitPricePaisa, discountPaisa: discount, weight: '', sortOrder: sortFrom + i + 1 };
    }
    const item = ctx.items && ctx.items[l.itemId];
    if (!item || item.category !== 'SKU') fail('E_VALIDATION', 'Choose a finished SKU for each planned output', field + '.itemId');
    const weight = isBlank(l.weight) ? 1 : Number(l.weight);
    if (!(weight > 0)) fail('E_VALIDATION', 'Weight must be more than zero', field + '.weight');
    return { description: text(l.description) || item.name, itemId: item.id, qty: qty, unitPricePaisa: '', discountPaisa: '', weight: weight, sortOrder: sortFrom + i + 1 };
  });
  return { lines: lines, totalPaisa: total };
}

const MTO_STATUS_FLOW = ['OPEN', 'IN_PRODUCTION', 'READY'];

// Changes to a job before delivery: details, status (OPEN / IN_PRODUCTION /
// READY only; delivery and cancellation post entries and have their own
// actions), extra charges (addLines) and discounts on existing lines.
// Returns {fields, newLines, lineUpdates}.
function prepareJobUpdate(job, existingLines, input, ctx) {
  if (['DELIVERED', 'CANCELLED', 'COMPLETED'].indexOf(job.status) >= 0) {
    fail('E_JOB_CLOSED', 'Job ' + job.id + ' is ' + job.status.toLowerCase() + ' and cannot be changed', 'id');
  }
  const fields = {};
  ['title', 'description', 'notes', 'collection'].forEach(function (k) {
    if (input[k] !== undefined) fields[k] = text(input[k]);
  });
  if (fields.title === '') fail('E_VALIDATION', 'Enter a title', 'title');
  if (input.promisedDate !== undefined) {
    fields.promisedDate = isBlank(input.promisedDate) ? '' : Validate.checkDate(input.promisedDate, 'promisedDate');
    if (fields.promisedDate && fields.promisedDate < job.bookedDate) fail('E_VALIDATION', 'Promised date is before the booking date', 'promisedDate');
  }
  if (input.budgetCostPaisa !== undefined) fields.budgetCostPaisa = optionalPaisa(input.budgetCostPaisa, 'budgetCostPaisa');
  if (input.status !== undefined && input.status !== job.status) {
    const allowed = job.type === 'MTO_ORDER' ? MTO_STATUS_FLOW : ['OPEN'];
    if (allowed.indexOf(input.status) === -1) fail('E_VALIDATION', 'Use Deliver, Complete or Cancel for that', 'status');
    fields.status = input.status;
  }
  let quoted = job.type === 'MTO_ORDER' ? Number(job.quotedPricePaisa || 0) : '';
  const lineUpdates = [];
  (input.lineDiscounts || []).forEach(function (d, i) {
    const line = existingLines.filter(function (l) { return l.id === d.lineId; })[0];
    if (!line || job.type !== 'MTO_ORDER') fail('E_NOT_FOUND', 'Line ' + d.lineId + ' is not on this order', 'lineDiscounts[' + i + ']');
    const discount = optionalPaisa(d.discountPaisa, 'lineDiscounts[' + i + '].discountPaisa') || 0;
    const gross = Inventory.qtyTimesPaisa(line.qty, line.unitPricePaisa);
    if (discount > gross) fail('E_VALIDATION', 'A discount is bigger than its line', 'lineDiscounts[' + i + '].discountPaisa');
    quoted += (line.discountPaisa || 0) - discount;
    lineUpdates.push({ id: line.id, fields: { discountPaisa: discount } });
  });
  const maxSort = existingLines.reduce(function (m, l) { return Math.max(m, Number(l.sortOrder) || 0); }, 0);
  const added = prepareJobLines(job.type, input.addLines || [], ctx, maxSort);
  if (job.type === 'MTO_ORDER') quoted += added.totalPaisa;
  if (job.type === 'MTO_ORDER' && (added.lines.length || lineUpdates.length)) fields.quotedPricePaisa = quoted;
  return { fields: fields, newLines: added.lines, lineUpdates: lineUpdates };
}

// A TaxCodes row (one effective-dated version). Rates come from the tax
// advisor; nothing in code assumes a rate.
function prepareTaxCode(input, all) {
  const id = text(input.id).toUpperCase();
  if (!/^[A-Z0-9][A-Z0-9.\-]{1,30}$/.test(id)) fail('E_VALIDATION', 'Tax code ID: letters, numbers, dots and dashes', 'id');
  const name = text(input.name);
  if (!name) fail('E_VALIDATION', 'Enter a name', 'name');
  const kind = oneOf(input.kind, ['SALES_OUTPUT', 'PURCHASE_INPUT', 'WHT', 'EXEMPT', 'ZERO'], 'kind', 'Kind');
  const other = (all || []).filter(function (t) { return t.id === id; })[0];
  if (other && other.kind !== kind) fail('E_VALIDATION', id + ' is a ' + other.kind + ' code; its kind cannot change', 'kind');
  const rate = Number(input.rateBps);
  if (!Number.isInteger(rate) || rate < 0 || rate > 10000) fail('E_VALIDATION', 'Rate must be 0 to 10000 basis points (18% = 1800)', 'rateBps');
  if ((kind === 'EXEMPT' || kind === 'ZERO') && rate !== 0) fail('E_VALIDATION', 'Exempt and zero-rated codes have a rate of 0', 'rateBps');
  const from = Validate.checkDate(input.effectiveFrom, 'effectiveFrom');
  const to = isBlank(input.effectiveTo) ? '' : Validate.checkDate(input.effectiveTo, 'effectiveTo');
  if (to && to < from) fail('E_VALIDATION', 'Effective to is before effective from', 'effectiveTo');
  return {
    row: {
      id: id, name: name, kind: kind, rateBps: rate,
      claimable: kind === 'PURCHASE_INPUT' ? Validate.isTrue(input.claimable) : false,
      whtBase: kind === 'WHT' ? oneOf(input.whtBase || 'EXCL_SALES_TAX', ['GROSS', 'EXCL_SALES_TAX'], 'whtBase', 'WHT base') : '',
      appliesTo: oneOf(input.appliesTo || 'ANY', ['GOODS', 'SERVICES', 'ANY'], 'appliesTo', 'Applies to'),
      vendorFilerStatus: oneOf(input.vendorFilerStatus || 'ANY', ['FILER', 'NON_FILER', 'ANY'], 'vendorFilerStatus', 'Filer status'),
      effectiveFrom: from, effectiveTo: to, isActive: isBlank(input.isActive) ? true : Validate.isTrue(input.isActive), notes: text(input.notes),
    },
  };
}

// Chart of accounts entry (M2.2). Codes are 4 digits in the range of their
// type (docs/03). Once an account has postings its type cannot change; system
// accounts keep their systemKey (the posting engine finds them by it).
const TYPE_RANGES = { ASSET: [1000, 1999], LIABILITY: [2000, 2999], EQUITY: [3000, 3999], REVENUE: [4000, 4999], COGS: [5000, 5999], EXPENSE: [6000, 6999], OTHER: [7000, 7999], TAX: [8000, 8999] };
function prepareAccount(input, existing, all, hasPostings) {
  const merged = Object.assign({}, existing || {}, input);
  const code = text(merged.code);
  if (!/^\d{4}$/.test(code)) fail('E_VALIDATION', 'Account code is 4 digits', 'code');
  if (!existing && (all || []).some(function (a) { return String(a.code) === code; })) fail('E_VALIDATION', 'Account ' + code + ' already exists', 'code');
  const type = oneOf(merged.type, Object.keys(TYPE_RANGES), 'type', 'Type');
  if (existing && existing.type !== type && hasPostings) fail('E_VALIDATION', 'This account has postings, so its type cannot change', 'type');
  const range = TYPE_RANGES[type];
  if (+code < range[0] || +code > range[1]) fail('E_VALIDATION', type + ' accounts are numbered ' + range[0] + '–' + range[1], 'code');
  const name = text(merged.name);
  if (!name) fail('E_VALIDATION', 'Enter a name', 'name');
  const isMoney = Validate.isTrue(merged.isMoney);
  if (isMoney && type !== 'ASSET') fail('E_VALIDATION', 'Only asset accounts hold money', 'isMoney');
  return {
    row: {
      id: code, code: code, name: name, type: type, subType: text(merged.subType),
      normalBalance: ['ASSET', 'COGS', 'EXPENSE', 'TAX'].indexOf(type) >= 0 ? (Validate.isTrue(merged.isContra) ? 'CREDIT' : 'DEBIT') : (Validate.isTrue(merged.isContra) ? 'DEBIT' : 'CREDIT'),
      isContra: Validate.isTrue(merged.isContra), systemKey: existing ? existing.systemKey || '' : '',
      defaultBrand: oneOf(merged.defaultBrand || 'SHARED', Validate.BRANDS, 'defaultBrand', 'Brand'),
      isMoney: isMoney, moneyKind: isMoney ? oneOf(merged.moneyKind, ['CASH', 'BANK', 'WALLET', 'CLEARING', 'PETTY'], 'moneyKind', 'Money kind') : '',
      qbAccountName: text(merged.qbAccountName), isActive: isBlank(merged.isActive) ? true : Validate.isTrue(merged.isActive),
      sortOrder: isBlank(merged.sortOrder) ? Number(code) : Number(merged.sortOrder),
    },
  };
}

// User create/update (Owner only).
function prepareUser(input, existing, all) {
  const merged = Object.assign({}, existing || {}, input);
  const email = text(merged.email).toLowerCase();
  if (!/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(email)) fail('E_VALIDATION', 'Enter the person\'s Google email address', 'email');
  const dup = (all || []).filter(function (u) { return u.email === email && u.id !== (existing || {}).id; })[0];
  if (dup) fail('E_VALIDATION', email + ' is already a user', 'email');
  const role = oneOf(merged.role, ['OWNER', 'FINANCE', 'STUDIO', 'STORE', 'VIEWER'], 'role', 'Role');
  const store = text(merged.store);
  if (role === 'STORE' && !store) fail('E_VALIDATION', 'Store staff need a store, e.g. MIRAE-KHI-01', 'store');
  return { row: { email: email, name: text(merged.name) || email, role: role, store: store, isActive: isBlank(merged.isActive) ? true : Validate.isTrue(merged.isActive) } };
}

return {
  CONTACT_KINDS,
  ITEM_CATEGORIES,
  normalizePhone,
  prepareContact,
  prepareItem,
  prepareJob,
  prepareJobLines,
  prepareJobUpdate,
  prepareTaxCode,
  prepareAccount,
  prepareUser,
};
})();

// ---- core/permissions.js ----
var Permissions = (function () {
// core/permissions.js: who may call which API action (docs/05-api-contract.md).
// The server checks this on every request; hiding buttons in the UI is cosmetic.
// Pure: no SpreadsheetApp, no DOM. Runs in Node and Apps Script.


const ROLES = ['OWNER', 'FINANCE', 'STUDIO', 'STORE', 'VIEWER'];
const ROLE_LETTER = { O: 'OWNER', F: 'FINANCE', S: 'STUDIO', T: 'STORE', V: 'VIEWER' };
const ROLE_LABEL = { OWNER: 'Owner', FINANCE: 'Finance', STUDIO: 'Studio', STORE: 'Store', VIEWER: 'Viewer' };

// action: [roles as letters, isWrite]
const MATRIX = {
