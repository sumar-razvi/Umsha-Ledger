  let credits = 0;
  const rows = chosen.map(function (l) {
    const j = inRange[l.jeId];
    debits += l.debitPaisa || 0;
    credits += l.creditPaisa || 0;
    const a = accountsByCode[l.accountCode] || {};
    const c = l.contactId && contacts ? contacts[l.contactId] : null;
